<h4 class="attribute-name box-title">{{localize "DND5E.ArmorClass"}}</h4>
<span class="attr-value">
	<span class="ac-value">{{system.attributes.ac.value}}</span>
	{{#if labels.armorType}}
		<span class="paren">(</span>{{~" "~}}
		<span class="ac-type">
			{{~labels.armorType~}}
		</span>{{~" "~}}
		<span class="paren">)</span>
	{{/if}}
</span>
<a class="config-button" data-config="armor" title="{{localize "DND5E.ARMORCLASS.Action.Configure"}}">
	<i class="fas fa-cog"></i>{{~" "~}}
</a>{{~" "~}}
