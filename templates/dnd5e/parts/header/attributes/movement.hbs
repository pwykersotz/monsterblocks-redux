<h4 class="attribute-name box-title">{{localize "DND5E.Speed"}}</h4>
{{#each movement as |move|~}}
	<span class="editable-wrapper{{#if (and move.value @index)}} optional-comma{{/if}}">
		{{~#if (and move.value move.showLabel)}}{{move.label}} {{/if~}}
		{{#if move.value}}{{move.value}}{{/if~}}
		{{~#if move.value}} {{move.unit}}{{/if~}}
		{{~#if (and move.fly @root.hover)~}}
			<span class="no-break nocaps">
				<span class="paren">(</span>
					{{~localize "DND5E.MOVEMENT.Hover"~}}
				<span class="paren">)</span>
			</span>
		{{~/if~}}
	</span>
{{~/each}}
{{~#if movementSpecial}}<span class="editable-wrapper optional-comma">{{movementSpecial}}</span>{{/if~}}
<a class="config-button" data-config="movement" title="{{localize "DND5E.MOVEMENT.Action.Configure"}}">
	<i class="fas fa-cog"></i>{{~" "~}}
</a>