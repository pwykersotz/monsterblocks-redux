<header class="sheet-header">
	<h1 class="charname" contenteditable="{{flags.editing}}" data-field-key="name"
		placeholder="{{localize "DND5E.Name"}}">{{actor.name}}</h1>
	{{#unless flags.hide-profile-image}}
		<figure class="profile-image">
			<img src="{{portrait.src}}" data-edit="{{portrait.path}}" title="{{actor.name}}{{#if flags.editing}} - {{localize "MOBLOKS5E.EditHint"}}{{/if}}">
		</figure>
	{{/unless}}
</header>
<main class="bio-box">
	<h4 class="attribute-name source">{{localize sourceStringId}}:</h4>
	<span contenteditable="{{flags.editing}}" data-field-key="system.source.custom"
		placeholder="{{localize sourceStringId}}">{{sourceLabel}}</span>
	<h2 class="section-header">{{localize "DND5E.Biography"}}</h2>
	<section class="biography active">
		{{#if (and owner flags.editing)}}
			<prose-mirror name="system.details.biography.value" value="{{biography.value}}"
				document-uuid="{{actor.uuid}}" toggled>{{{biography.enriched}}}</prose-mirror>
		{{else}}
			<div class="editor-content">{{{biography.enriched}}}</div>
		{{/if}}
	</section>
</main>
